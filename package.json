{
  "name": "a0-mcp-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Read-only MCP server over SSE (SWAPI via swapi.info) gated by Auth0 with RBAC on urn:mcp. Built as a four-commit ladder for a blog series.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "smoke": "node client/smoke.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
