# Copy to .env and edit. Real identifiers live ONLY in the untracked .env.
# Never commit real tenant values.
#
# One Next process at the repo root reads ./.env natively, so one file holds
# everything: the OAuth dance and the MCP transport both read it.

WEB_URL=http://localhost:3000

# Auth0. Create a Native/SPA application with:
#   callback:   http://localhost:3000/callback
#   logout:     http://localhost:3000/logged-out
#   web origin: http://localhost:3000
# And on the urn:mcp API: Application Access Policy / User-Delegated Access
# set to "All apps allowed" so the app may request that audience.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=urn:mcp